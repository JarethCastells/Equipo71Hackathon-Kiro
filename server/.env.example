
# Puerto del servidor
PORT=4000

# Secreto para firmar los JWT (cambia esto en producción)
JWT_SECRET=change-this-super-secret-value

# URL del frontend (para links en emails y CORS)
CLIENT_URL=http://localhost:5173

# Número de "hops" de proxy confiables delante de este servidor (Express
# "trust proxy"). Déjalo en 0 (o sin definir) si el servidor recibe tráfico
# directo de internet, como en desarrollo local. Ponlo en 1 si despliegas
# detrás de UN proxy/load balancer (Railway, Render, Vercel, nginx), o un
# número mayor si hay varios encadenados (ej. CDN + load balancer).
# IMPORTANTE: activarlo sin tener un proxy real delante permite que
# cualquier visitante falsifique su IP vía el header X-Forwarded-For y evada
# el rate limiting por IP.
TRUST_PROXY=0

# Clave para cifrar datos sensibles en reposo (cuentas bancarias). Genera una
# propia con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-this-to-a-random-64-char-hex-string

# --- Base de datos MySQL (hosting Neubox de teotek.com.mx) ---
# En cPanel/Neubox: sección "Bases de datos MySQL" para crear la BD y el
# usuario (suelen llevar prefijo, ej. teotekco_talentflow / teotekco_appuser),
# y sección "Remote MySQL / Acceso remoto a bases de datos" para autorizar
# la IP pública desde la que corre este servidor Node (no la de tus visitantes).
# Si el backend se despliega en el mismo hosting que la BD, usa DB_HOST=localhost.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Pon en "true" solo si tu proveedor exige SSL para conexiones remotas.
DB_SSL=false

# --- Configuración SMTP para el correo de bienvenida ---
# Si dejas estas variables vacías, el servidor usa una cuenta de prueba
# de Ethereal automáticamente y muestra en consola una URL para previsualizar
# el correo enviado (útil en desarrollo, no envía correos reales).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TalentFlow AI <no-reply@talentflow.ai>"

# --- IA / Matching inteligente (Google Gemini) ---
# API key GRATUITA. Obtenerla en: https://aistudio.google.com/apikey
# Pasos:
#   1. Iniciar sesión con cuenta Google
#   2. Clic "Create API Key" → seleccionar o crear proyecto
#   3. Copiar la key y pegar aquí
# Sin esta key el sistema funciona con scoring heurístico (sin IA real).
# Autenticación: se envía vía header X-goog-api-key en cada request.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Pagos (Stripe) ---
# TODO: pega aquí tu llave secreta de PRUEBA (sk_test_...) desde
# https://dashboard.stripe.com/test/apikeys. Sin esto, las rutas de pago
# devuelven 503 pero el resto de la app sigue funcionando con normalidad.
STRIPE_SECRET_KEY=
# Para desarrollo local, generar con: stripe listen --forward-to localhost:4000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mxn
